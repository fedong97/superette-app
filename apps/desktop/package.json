{
  "name": "@superette/desktop",
  "productName": "Superette Gestion",
  "version": "0.9.0",
  "private": true,
  "description": "Caisse et gestion de superette",
  "author": "Superette Gestion",
  "main": "out/main/index.js",
  "scripts": {
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3 -m ../..",
    "dev": "npm run rebuild:electron && electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "build:win": "electron-vite build && electron-builder --win --x64"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.0",
    "electron-updater": "^6.6.0"
  },
  "devDependencies": {
    "@superette/core": "0.1.0",
    "@superette/db": "0.1.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "38.8.6",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vite": "^7.1.0",
    "@electron/rebuild": "^4.0.0"
  }
}
